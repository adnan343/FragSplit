map "$host:$http_x_forwarded_proto" $store_hsts {
    default "";
    "${HSTS_HOST}:https" "max-age=15552000";
}

server {
    listen 3000 default_server;
    server_tokens off;
    client_max_body_size 6m;
    add_header Strict-Transport-Security $store_hsts always;

    set_real_ip_from ${TRUSTED_TUNNEL_PROXY};
    real_ip_header CF-Connecting-IP;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ~* ^/(api/|health$) {
        set $api api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-VialMuse-Client-IP $remote_addr;
        proxy_set_header X-VialMuse-Ingress "${INGRESS_SECRET}";
        proxy_set_header X-VialMuse-Catalog-Origin "";
        proxy_pass http://$api;
    }

    location / {
        set $web web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-VialMuse-Client-IP "";
        proxy_set_header X-VialMuse-Ingress "";
        proxy_set_header X-VialMuse-Catalog-Origin "";
        proxy_pass http://$web;
    }
}
