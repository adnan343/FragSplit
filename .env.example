# Create a fresh local database password and a separate bootstrap password.
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=true
PUBLIC_ORIGIN=http://localhost:3000
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox
CALLBACK_BASE_URL=
RESERVATION_MINUTES=15
# Optional S3-compatible store. Use workload credentials or standard AWS variables.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Customer account mail. Use STARTTLS with a sender authorized by your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
