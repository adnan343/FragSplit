# Use distinct hex secrets for each database role and the private ingress hop.
POSTGRES_PASSWORD=
SHOP_MIGRATION_PASSWORD=
SHOP_RUNTIME_PASSWORD=
INGRESS_SECRET=
CATALOG_ORIGIN_SECRET=
HSTS_HOST=disabled.invalid
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
SEED_DEMO=true
PUBLIC_ORIGIN=http://localhost:3000
COD_HOLD_MINUTES=1440
# Optional S3-compatible store. Use workload credentials or standard AWS variables.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Customer account mail. Use STARTTLS with a sender authorized by your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
